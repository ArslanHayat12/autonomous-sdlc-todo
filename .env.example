# Required only for AI-assisted workflow steps
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Default SDLC instruction when you run `npm run sdlc:auto` with no CLI args (or in CI)
SDLC_INSTRUCTION=

# Monorepo root for SDLC git operations (default: inferred). Set when running from a dedicated worker clone.
SDLC_REPO_ROOT=
# When worker uses SDLC_REPO_ROOT, set this to your Cursor/dirty workspace to mirror uncommitted changes into the worktree
SDLC_PRIMARY_REPO_ROOT=
# Set to 1 to enable mirroring from SDLC_PRIMARY_REPO_ROOT (see orchestrator/sdlc/repo-root.ts)
SDLC_WORKER_SYNC_FROM_PRIMARY=

# Optional pre-worktree verification on main checkout (see runMainRepoVerificationBeforeSdlc)
SDLC_VERIFY_COMMAND=
SDLC_SKIP_MAIN_VERIFY=

# Optional GitHub publishing (local branch/commit works without these)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# `gh label create` runs before PR create when github.autoLabel is true (set to 1 to skip)
SDLC_SKIP_LABEL_ENSURE=

# Skip automatic git fetch + fast-forward on base branch (see sdlc.features.json autoPullMain*)
SDLC_SKIP_AUTO_PULL=

# Skip rebase onto origin/<base> + force-with-lease push before gh pr merge (default: run sync)
SDLC_SKIP_SYNC_BEFORE_MERGE=

# After a successful merge: skip hard-reset of local base branch to origin/<base> (see resetMainCheckoutAfterMerge)
SDLC_SKIP_RESET_MAIN_AFTER_MERGE=

# Cursor hook `.cursor/hooks/sdlc-publish-on-stop.sh`: run `npm run sdlc:publish` after agent stop (needs agentEditAutoPublish + isolatedWorktree false)
SDLC_CURSOR_PUBLISH_ON_STOP=

# Optional Figma context (MCP connection is configured separately)
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Deployment is deliberately approval-gated
DEPLOY_APPROVED=false
