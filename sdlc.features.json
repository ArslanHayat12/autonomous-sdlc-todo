{
  "meta": {
    "version": 1,
    "description": "SDLC feature toggles. Edit nested groups; orchestrator merges into flat runtime flags."
  },
  "automation": {
    "fullAgentAutomation": true,
    "requireHumanApprovalBeforeMerge": false
  },
  "ai": {
    "autoImplement": true,
    "heroSkills": true,
    "review": true,
    "reviewAutoFix": true,
    "reviewPrComments": true,
    "commitMessageFromSkills": true
  },
  "git": {
    "isolatedWorktree": true,
    "pruneStaleWorktreesOnStart": true,
    "syncUncommittedFromMain": true,
    "pullMainBeforeRun": true,
    "pullMainAfterPr": true,
    "pullMainAfterMerge": true,
    "resetMainCheckoutAfterMerge": true,
    "alignMainWithRemoteAfterRun": true
  },
  "delivery": {
    "autoCommit": true,
    "autoPush": true,
    "autoPr": true,
    "autoMerge": true,
    "mergeUseGhAuto": true
  },
  "quality": {
    "gatesInWorktree": false,
    "verifyMainBeforeRun": true,
    "mainVerificationCommand": "npm run build"
  },
  "deploy": {
    "localAfterMerge": false
  },
  "integrations": {
    "cursor": {
      "agentEditAutoPublish": false
    }
  }
}
