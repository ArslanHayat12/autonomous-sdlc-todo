{
  "name": "autonomous-sdlc-todo",
  "private": true,
  "workspaces": ["apps/web", "apps/api", "orchestrator"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build && npm --workspace orchestrator run build",
    "test:orchestrator": "npm --workspace orchestrator run test",
    "test:e2e": "playwright test",
    "sdlc": "npm --workspace orchestrator run sdlc",
    "security": "npm audit --audit-level=high",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
