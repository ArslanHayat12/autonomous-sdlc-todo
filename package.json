{
  "name": "autonomous-sdlc-todo",
  "private": true,
  "workspaces": ["apps/web", "apps/api", "orchestrator"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build && npm --workspace orchestrator run build",
    "test:orchestrator": "npm --workspace orchestrator run test",
    "test:e2e": "playwright test",
    "sdlc": "npm --workspace orchestrator run sdlc",
    "sdlc:auto": "node scripts/sdlc-auto.mjs",
    "sdlc:publish": "node scripts/sdlc-publish-auto.mjs",
    "sdlc:worker": "npm --workspace orchestrator run sdlc:worker",
    "sdlc:status": "npm --workspace orchestrator run sdlc:worker-status",
    "sdlc:stop": "npm --workspace orchestrator run sdlc:worker-stop",
    "sdlc:dry-run": "npm run sdlc -- --dry-run",
    "sdlc:resume": "npm run sdlc -- --resume",
    "security": "npm audit --audit-level=high",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
